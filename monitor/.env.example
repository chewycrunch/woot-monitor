# Copy this file to .env — it is gitignored so your local overrides stay local
# cp .env.example .env

# Base URL of the tls-client API.
# Leave unset to use the default, http://127.0.0.1:8080.
# TLS_API_URL=http://127.0.0.1:8080

# Log filtering, passed straight to tracing's EnvFilter.
# Leave unset to use the default, woot_monitor=info,offers=info.
# New-offer events use the `offers` target so they can be filtered on their own.
# RUST_LOG=woot_monitor=debug,offers=info,reqwest=warn

# Set to `json` to emit one structured JSON object per log line.
# Leave unset for human-readable, coloured output.
# LOG_FORMAT=json
